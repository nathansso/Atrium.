# Atrium — sponsor configuration
#
# Copy to .env.local. The default (mock) runs the entire demo offline with no
# keys and no Docker. Switch to live once your sponsor accounts exist.
#
# Mode is resolved per internal provider driver: in live mode, any sponsor whose keys are
# missing falls back to its mock with a one-time warning. A dead key costs
# one layer, never the whole run.

SPONSOR_MODE=mock

# ---------------------------------------------------------------------------
# Memory — FalkorDB
#   docker run -d -p 6379:6379 -p 3002:3000 --name falkordb falkordb/falkordb:latest
#   Browser UI: http://localhost:3002
# ---------------------------------------------------------------------------
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=atrium

# ---------------------------------------------------------------------------
# Live — LaserData
#   git clone https://github.com/laserdata/laser-stack && ./scripts/up
#   The stack prints a connection string on first run — paste it here.
#   Cloud free tier: https://laserdata.cloud/?source=sf-memory-motion-hackthon-2026
# ---------------------------------------------------------------------------
LASER_CONNECTION_STRING=iggy:laser@127.0.0.1:8090
LASER_STREAM=atrium

# ---------------------------------------------------------------------------
# Motion — RocketRide
#   Create an account and generate an API key. This is the ONLY sponsor with
#   no local fallback — without this key the motion lane runs on fixtures.
# ---------------------------------------------------------------------------
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=https://api.rocketride.ai

# ---------------------------------------------------------------------------
# Agents — Guild.ai
#   npm i -g @guildai/cli && guild auth login
#   (@guildai/agents-sdk is served from a private registry the CLI configures;
#    a 404 on public npm is expected, not an error.)
# ---------------------------------------------------------------------------
GUILD_API_KEY=
GUILD_WORKSPACE=

# ---------------------------------------------------------------------------
# Research — Firecrawl (source-grounded curriculum authoring)
#   Hosted API, no local fallback. Leave blank to run the deterministic mock
#   fixture; set a key with SPONSOR_MODE=live to use real web search.
#   Get a key at https://firecrawl.dev
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=
# Optional overrides:
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
# FIRECRAWL_MAX_RESULTS=8
